{
  "modules": [
    "./register.tsx"
  ],
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/node-guard.mjs\" \"${CLAUDE_PLUGIN_ROOT}/hooks/permission-wait.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/node-guard.mjs\" \"${CLAUDE_PLUGIN_ROOT}/hooks/permission-wait.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/node-guard.mjs\" \"${CLAUDE_PLUGIN_ROOT}/hooks/permission-wait.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/node-guard.mjs\" \"${CLAUDE_PLUGIN_ROOT}/hooks/permission-wait.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/node-guard.mjs\" \"${CLAUDE_PLUGIN_ROOT}/hooks/permission-wait.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/node-guard.mjs\" \"${CLAUDE_PLUGIN_ROOT}/hooks/elicit/ask-hook.mjs\"",
            "timeout": 1320
          }
        ]
      }
    ]
  }
}
