#!/usr/bin/env bash
# Answer a waiting Next up question from a shell (the fallback when the pane controls do not work).
#   nextup-answer            list waiting questions
#   nextup-answer <id> <value> [field]   answer with a choice (yes/no for booleans), field defaults to the first
#   nextup-answer <id> --cancel          skip the question (the worker is told it was cancelled)
# Board folder: NEXTUP_BOARD, else the Next up dataDir option as CLAUDE_PLUGIN_OPTION_dataDir.
set -euo pipefail
board=${NEXTUP_BOARD:-${CLAUDE_PLUGIN_OPTION_dataDir:-}}
board=${board/#\~/$HOME}
[[ -n $board && -d $board ]] || { echo "set NEXTUP_BOARD to the Next up data folder" >&2; exit 2; }
BOARD=$board node - "$@" <<'JS'
const fs = require('node:fs'), path = require('node:path')
const [id, value, field] = process.argv.slice(2)
const dir = process.env.BOARD
const read = f => { try { const v = JSON.parse(fs.readFileSync(path.join(dir, f), 'utf8')); return Array.isArray(v) ? v : [] } catch { return [] } }
const newest = rows => [...new Map(rows.sort((a, b) => a.at - b.at).map(r => [r.id, r])).values()]
const now = Date.now()
// Same rule as the pane: waiting, not a browser ask, and not past its own timeout.
const asks = newest(read('asks.json')).filter(a => a.status === 'waiting' && !a.kind && now < a.askedAt + (a.timeoutSec ?? 0) * 1000)
// A field's choices: oneOf constants, else enum, else yes|no for a boolean.
const choices = f => f.oneOf ? f.oneOf.map(o => o.const) : f.enum ?? null
if (!id) {
  if (!asks.length) console.log('Nothing waiting.')
  for (const a of asks) {
    const props = Object.entries(a.schema?.properties ?? {})
    console.log(`${a.id}\t${a.thread}: ${a.message}\t${props.map(([k, f]) => `${k}=${choices(f) ? choices(f).join('|') : f.type === 'boolean' ? 'yes|no' : 'text'}`).join(' ')}`)
  }
  process.exit(0)
}
const ask = asks.find(a => a.id === id)
if (!ask) { console.error(`No waiting question with id ${id}`); process.exit(1) }
const row = { id, at: Date.now(), answeredBy: 'darren' }
if (value === '--cancel') Object.assign(row, { content: {}, cancel: true })
else {
  const props = ask.schema?.properties ?? {}
  const name = field || Object.keys(props)[0]
  const f = props[name]
  if (!f || value === undefined) { console.error('usage: nextup-answer <id> <value> [field]'); process.exit(1) }
  let v = value
  if (f.type === 'boolean') {
    if (/^(y|yes|yep|true|1)$/i.test(value)) v = true
    else if (/^(n|no|nope|false|0)$/i.test(value)) v = false
    else { console.error('Answer yes or no.'); process.exit(1) }
  }
  else if (choices(f) && !choices(f).includes(value)) { console.error(`Choose one of: ${choices(f).join(', ')}`); process.exit(1) }
  row.content = { ...(ask.default ?? {}), [name]: v }
}
// Read, add, write, then read back; retry if another writer (the pane has no lock to take) overwrote the row.
// A mkdir lock keeps two helpers from racing each other, the same lock the hook uses for its own files.
const file = path.join(dir, 'answers.json'), lock = path.join(dir, '.answers.json.lock')
const sleep = ms => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms)
const until = Date.now() + 5000
for (;;) {
  try { fs.mkdirSync(lock); break } catch (e) {
    if (e.code !== 'EEXIST') break
    try { if (Date.now() - fs.statSync(lock).mtimeMs > 10000) fs.rmdirSync(lock) } catch {}
    if (Date.now() > until) break
    sleep(25 + Math.random() * 50)
  }
}
try {
  for (let attempt = 0; attempt < 5; attempt++) {
    const tmp = `${file}.${process.pid}.${Date.now()}.tmp`
    fs.writeFileSync(tmp, JSON.stringify([...read('answers.json'), row], null, 1), { mode: 0o600 }); fs.renameSync(tmp, file)
    if (read('answers.json').some(r => r.id === row.id && r.at === row.at)) break
  }
} finally { try { fs.rmdirSync(lock) } catch {} }
console.log(`Answered ${id}.`)
JS
